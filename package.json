{
  "name": "@hexlabelposition/ward",
  "version": "0.3.0",
  "description": "Git hooks from one typed config. Tasks on staged files, safe partial staging, no hook folder in the repo. Node, Bun and Deno.",
  "license": "MIT",
  "author": "Vladyslav Kudriashov",
  "homepage": "https://github.com/hexlabelposition/ward#readme",
  "bugs": "https://github.com/hexlabelposition/ward/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlabelposition/ward.git"
  },
  "keywords": [
    "git",
    "git-hooks",
    "staged-files",
    "partial-staging",
    "linting",
    "formatting",
    "typescript",
    "bun",
    "deno",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "ward": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./schema.json": "./schema.json",
    "./local.schema.json": "./local.schema.json",
    "./package.schema.json": "./package.schema.json"
  },
  "files": [
    "dist",
    "schema.json",
    "local.schema.json",
    "package.schema.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsdown && node dist/cli.mjs --bin dist/cli.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run",
    "test:deno": "deno run -A test/run-deno.ts run",
    "test:watch": "vitest",
    "schema": "node scripts/schema.ts && prettier --write schema.json local.schema.json package.schema.json",
    "release": "bumpp --sign"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  }
}
